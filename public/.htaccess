# IONOS web hosting (Apache). `npm run build` copies this file into dist/; upload it with the rest of dist/.
# Upload order: assets/ and sponsors/ first, index.html last, so the page never asks for files that are not there yet.
# Every block is wrapped in <IfModule> so a module the host leaves out is skipped instead of causing a 500 error.

Options -Indexes
DirectoryIndex index.html

# Correct MIME types (browsers refuse to run an ES module script served as text/plain)
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json .webmanifest
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/wasm .wasm
  AddCharset UTF-8 .html .css .js .mjs .json .svg
</IfModule>

# gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml text/plain
</IfModule>

# Caching: the page is always re-checked; the built scripts and styles carry a hash in the file name, so they can be kept for a year
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # multiplayer.json is edited by hand on the web space: never keep it for long
  <FilesMatch "^multiplayer\.json$">
    Header set Cache-Control "public, max-age=60, must-revalidate"
  </FilesMatch>
  # Only a real script or stylesheet is kept for a year. If one is asked for before the upload has finished, the host answers
  # with its HTML "not found" page; that must not be cached under the script's name, or the browser keeps the broken copy.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{CONTENT_TYPE} =~ m#(javascript|css)#"
    Header set Cache-Control "no-store" "expr=%{CONTENT_TYPE} =~ m#text/html#"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 1 minute"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 day"
  ExpiresByType image/webp "access plus 1 day"
</IfModule>

# Once HTTPS is switched on for the domain (it should be: the multiplayer broker is reached over wss://, which a plain http page
# is allowed to do, but browsers also need https for clipboard copy), remove the # from these four lines to force it.
#<IfModule mod_rewrite.c>
#  RewriteEngine On
#  RewriteCond %{HTTPS} off
#  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
#</IfModule>
