# Cloudflare Pages: https://developers.cloudflare.com/pages/configuration/headers/
# `npm run build` copies this file into dist/. Pages already compresses text files (gzip or brotli) on its own.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# the page itself: always check for a new version, so a new deploy shows up on the next load
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# the built scripts and styles have a content hash in the file name (index-CcO3MopZ.js), so a changed file is a new name
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# sponsor boards and anything else in public/: cache for a day
/sponsors/*
  Cache-Control: public, max-age=86400
